<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="mycarrier_so_accessorial_form" model="ir.ui.view">
        <field name="name">mycarrier.so.accessorial.form</field>
        <field name="model">mycarrier.so.accessorial</field>
        <field name="arch" type="xml">
            <form string="MyCarrier Accessorials">
                <field name="choose_wizard_id" invisible="1"/>
                <field name="order_id" invisible="1"/>
                <field name="carrier_id" invisible="1"/>
                <p class="text-muted">Review the accessorials for this shipment, change them if needed, then show the rates.</p>
                <group>
                    <group string="Origin">
                        <field name="origin_location_type" options="{'no_create': True}"/>
                        <field name="origin_inside_pickup"/>
                        <field name="origin_liftgate_pickup"/>
                        <field name="origin_protect_from_freeze"/>
                        <field name="origin_single_shipment"/>
                        <field name="origin_inbond_freight"/>
                    </group>
                    <group string="Destination">
                        <field name="dest_location_type" options="{'no_create': True}"/>
                        <field name="dest_delivery_appointment"/>
                        <field name="dest_inside_delivery"/>
                        <field name="dest_liftgate_delivery"/>
                        <field name="dest_notify_delivery"/>
                        <field name="dest_sort_segregate_delivery"/>
                    </group>
                </group>
                <footer>
                    <button name="action_show_rates" type="object" string="Show Rates" class="btn-primary" data-hotkey="q"/>
                    <button name="action_back" type="object" string="Back" class="btn-secondary" data-hotkey="x"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>
